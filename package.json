{
  "name": "42km-theme",
  "displayName": "42KM color theme",
  "description": "A Marathon-inspired dark color theme",
  "homepage": "https://github.com/andornaut/vscode-42km-theme",
  "icon": "icon.png",
  "license": "MIT",
  "private": true,
  "publisher": "Andornaut",
  "version": "0.2.0",
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "42KM",
        "label": "42KM",
        "uiTheme": "vs-dark",
        "path": "./themes/42km-dark-color-theme.json"
      }
    ]
  },
  "engines": {
    "node": ">=24.21.0",
    "vscode": "^1.60.0"
  },
  "galleryBanner": {
    "color": "#1b1a1d",
    "theme": "dark"
  },
  "keywords": [
    "42KM",
    "dark",
    "green",
    "lime",
    "marathon",
    "solarized dark",
    "solarized"
  ],
  "bugs": {
    "url": "https://github.com/andornaut/vscode-42km-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andornaut/vscode-42km-theme"
  },
  "scripts": {
    "format": "make exec COMMAND='npm run format:internal'",
    "lint": "make lint",
    "package": "make build",
    "prepare": "husky",
    "swatches": "rm -rf swatches && mkdir swatches && color-swatches --format png swatches themes/*.json",
    "lint:internal": "prettier --check .",
    "format:internal": "prettier --write .",
    "package:internal": "mkdir -p dist && vsce package --out dist/",
    "check": "make check",
    "test": "make test",
    "build": "make build"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "color-swatches": "github:andornaut/color-swatches-action#v1.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
